# Copy to .env. Never commit .env.
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
JEV_API_KEY=

# Each coding role can use OpenAI or Anthropic independently.
CHEAP_PROVIDER=openai
CHEAP_MODEL=gpt-5.6-luna
CHEAP_INPUT_USD_PER_MILLION=0.20
CHEAP_CACHED_INPUT_USD_PER_MILLION=0.02
CHEAP_OUTPUT_USD_PER_MILLION=1.20

STRONG_PROVIDER=openai
STRONG_MODEL=gpt-6-astra
STRONG_INPUT_USD_PER_MILLION=10.00
STRONG_CACHED_INPUT_USD_PER_MILLION=1.00
STRONG_OUTPUT_USD_PER_MILLION=50.00

JEV_MODEL=jev-1.13.0
JEV_URL=https://api.typesafe.ai/v1/systemone
JEV_INPUT_USD_PER_MILLION=0.042

REASONING_EFFORT=medium
MAX_COMPLETION_TOKENS=8000
CHEAP_BUDGET_USD=3
JEV_BUDGET_USD=3
STRONG_BUDGET_USD=12
MAX_PARALLEL_RUNS=15
MAX_PARALLEL_GRADERS=2
PROVIDER_MAX_RETRIES=3
